              <a href="https://wa.me/919994770276?text=Hi!%20I%20submitted%20a%20demo%20request%20on%20EasyToReach%20website" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#25d366,#008069);color:#fff;text-decoration:none;padding:11px 24px;border-radius:100px;font-weight:700;font-size:0.88rem;">
