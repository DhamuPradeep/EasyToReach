  <script>
    // Landing Page Controller, Theme, Accordion & Scroll Observer
    const LandingApp = {
      currentTheme: 'light',

      init() {
        const savedTheme = localStorage.getItem("textile_theme") || 
          (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        this.applyTheme(savedTheme);
        this.initScrollReveal();
        this.initCounters();
        this.initScrollProgress();
      },

      initScrollProgress() {
        const bar = document.getElementById("scrollProgressBar");
        if (!bar) return;
        const updateProgress = () => {
          const bodyEl = document.getElementById("landingBody");
          let scrollTop = bodyEl ? bodyEl.scrollTop : window.pageYOffset;
          let scrollHeight = bodyEl ? (bodyEl.scrollHeight - bodyEl.clientHeight) : (document.documentElement.scrollHeight - window.innerHeight);
          if (scrollHeight <= 0) {
            scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
          }
          const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
          bar.style.width = `${Math.min(Math.max(progress, 0), 100)}%`;
        };
        const bodyEl = document.getElementById("landingBody");
        if (bodyEl) bodyEl.addEventListener("scroll", updateProgress, { passive: true });
        window.addEventListener("scroll", updateProgress, { passive: true });
      },

      simData: {
        birthday: {
          content: `🎉 Happy Birthday <strong>Meenakshi</strong>! 🎂✨<br><br>Warm wishes from <strong>EasyToReach Store</strong>!<br>Enjoy an exclusive <strong>15% BIRTHDAY DISCOUNT</strong> on our new collection!<br><br>📌 Show this at checkout.<br>⏳ Valid for the next 7 days.`,
          time: '09:00 AM',
          buttons: ['<i class="fa-solid fa-tag"></i> Claim 15% Voucher', '<i class="fa-solid fa-store"></i> View Store Catalog']
        },
        receipt: {
          content: `🧾 <strong>EASYTOREACH STORE</strong> — Tax Invoice<br><br>Dear <strong>Ananya</strong>,<br>Thank you for shopping with us today!<br><br>📄 Bill No: #ETR-8492<br>💰 Total Paid: ₹4,500<br>⭐ Loyalty Cashback: <strong>+225 Points</strong><br>🎁 Current Balance: <strong>580 Points</strong> (₹580 cash value)`,
          time: '04:15 PM',
          buttons: ['<i class="fa-solid fa-file-pdf"></i> Download PDF Bill', '<i class="fa-solid fa-star"></i> Rate Experience ⭐⭐⭐⭐⭐']
        },
        festival: {
          content: `✨ <strong>FESTIVE MEGA SALE</strong> 🎁<br><br>Exciting new collections and festive arrivals are here at <strong>EasyToReach Store</strong>!<br>Flat ₹500 OFF on purchases above ₹3,000 this festive weekend.<br><br>📍 Visit our nearest store or order online<br>⏳ Limited festive offer!`,
          time: '11:30 AM',
          buttons: ['<i class="fa-solid fa-bag-shopping"></i> Browse Catalog', '<i class="fa-solid fa-tag"></i> Claim Festive Offer']
        }
      },

      switchSim(type, btnEl, pos) {
        document.querySelectorAll('.phone-tab').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');

        // Move slider track
        const slider = document.getElementById('simSlider');
        if (slider) {
          slider.className = `slider-track pos-${(pos || 0) + 1}`;
        }

        const contentEl = document.getElementById('simBubbleContent');
        const timeEl = document.getElementById('simBubbleTime');
        const btnsEl = document.getElementById('simBubbleButtons');
        const bubbleEl = document.getElementById('simBubble');
        if (!contentEl) return;

        // Fade out
        if (bubbleEl) {
          bubbleEl.style.opacity = '0';
          bubbleEl.style.transform = 'translateY(6px)';
          bubbleEl.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
        }
        if (btnsEl) {
          btnsEl.style.opacity = '0';
          btnsEl.style.transition = 'opacity 0.15s ease';
        }

        setTimeout(() => {
          // Show typing indicator
          contentEl.innerHTML = `<span style="display:flex; align-items:center; gap:5px; color:#aaa; font-style:italic;"><span class="typing-dot"></span><span class="typing-dot" style="animation-delay:0.15s"></span><span class="typing-dot" style="animation-delay:0.3s"></span></span>`;
          if (bubbleEl) {
            bubbleEl.style.opacity = '1';
            bubbleEl.style.transform = 'translateY(0)';
          }

          setTimeout(() => {
            const item = this.simData[type] || this.simData.birthday;
            contentEl.innerHTML = item.content;
            if (timeEl) timeEl.innerHTML = `${item.time} <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i>`;
            if (btnsEl) {
              btnsEl.innerHTML = item.buttons.map(b => `<button class="sim-action-btn">${b}</button>`).join('');
              btnsEl.style.opacity = '0';
              btnsEl.style.display = 'flex';
              setTimeout(() => { btnsEl.style.opacity = '1'; }, 50);
            }
          }, 500);
        }, 200);
      },

      initCounters() {
        const counters = document.querySelectorAll('.counter-num');
        let animated = false;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !animated) {
              animated = true;
              counters.forEach(c => {
                const target = parseFloat(c.getAttribute('data-target') || 0);
                const prefix = c.getAttribute('data-prefix') || '';
                const suffix = c.getAttribute('data-suffix') || '';
                let val = 0;
                const duration = 1200;
                const startTime = performance.now();
                function update(now) {
                  const elapsed = now - startTime;
                  const progress = Math.min(elapsed / duration, 1);
                  const easeProgress = 1 - (1 - progress) * (1 - progress);
                  val = target * easeProgress;
                  c.textContent = prefix + (Number.isInteger(target) ? Math.round(val) : val.toFixed(1)) + suffix;
                  if (progress < 1) {
                    requestAnimationFrame(update);
                  } else {
                    c.textContent = prefix + target + suffix;
                  }
                }
                requestAnimationFrame(update);
              });
            }
          });
        }, { threshold: 0.25 });

        const kpi = document.querySelector('.kpi-section');
        if (kpi) observer.observe(kpi);
      },

      toggleTheme() {
        const nextTheme = this.currentTheme === 'dark' ? 'light' : 'dark';
        const icon = document.getElementById("themeIcon");
        if (icon) {
          icon.classList.remove("icon-spin");
          void icon.offsetWidth;
          icon.classList.add("icon-spin");
        }
        this.applyTheme(nextTheme);
      },

      applyTheme(theme) {
        this.currentTheme = theme;
        document.documentElement.setAttribute("data-theme", theme);
        document.body.setAttribute("data-theme", theme);
        localStorage.setItem("textile_theme", theme);

        const icon = document.getElementById("themeIcon");
        const label = document.getElementById("themeLabel");
        if (icon) {
          icon.className = theme === "dark" ? "fa-solid fa-sun" : "fa-solid fa-moon";
        }
        if (label) {
          label.textContent = theme === "dark" ? "Light" : "Dark";
        }
      },

      toggleMobileMenu() {
        const drawer = document.getElementById("mobileDrawer");
        const icon = document.getElementById("mobileMenuIcon");
        drawer.classList.toggle("open");
        if (drawer.classList.contains("open")) {
          icon.className = "fa-solid fa-xmark";
        } else {
          icon.className = "fa-solid fa-bars";
        }
      },

      toggleFAQ(el) {
        const isOpen = el.classList.contains('faq-open');
        // Close all other open FAQs for clean accordion behaviour
        document.querySelectorAll('.faq-item.faq-open').forEach(item => {
          if (item !== el) {
            item.classList.remove('faq-open');
          }
        });
        if (isOpen) {
          el.classList.remove('faq-open');
        } else {
          el.classList.add('faq-open');
        }
      },

      initScrollReveal() {
        const reveals = document.querySelectorAll(".reveal");
        // Immediately reveal elements already inside initial viewport
        reveals.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            el.classList.add("active");
          }
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
            }
          });
        }, { threshold: 0.08 });

        reveals.forEach(r => observer.observe(r));
      },

      updateROI(val) {
        document.getElementById("calcCustLabel").textContent = parseInt(val).toLocaleString("en-IN");
        // Formula: customers * 14% repeat conversion * ₹3,200 avg order value
        const repeatBuyers = Math.round(val * 0.14);
        const revenue = repeatBuyers * 3200;
        const resEl = document.getElementById("calcRevenueResult");
        if (resEl) {
          resEl.textContent = `₹${revenue.toLocaleString("en-IN")}`;
          resEl.style.transform = 'scale(1.06)';
          resEl.style.transition = 'transform 0.15s ease';
          clearTimeout(this._roiTimer);
          this._roiTimer = setTimeout(() => { resEl.style.transform = 'scale(1)'; }, 150);
        }
      },

      // ── Book a Demo ───────────────────────────────────────────────────
      openDemoModal() {
        window.location.href = "/book-demo";
      },

      closeDemoModal(e) {
        // If called from backdrop click, only close if the backdrop itself was clicked
        if (e && e.target !== document.getElementById("demoModalBackdrop")) return;
        const backdrop = document.getElementById("demoModalBackdrop");
        if (backdrop) backdrop.classList.remove("open");
        document.body.style.overflow = "";
      },

      switchDemoTab(tab) {
        const calBtn   = document.getElementById("demoTabCalendar");
        const formBtn  = document.getElementById("demoTabForm");
        const calPanel = document.getElementById("demoPanelCalendar");
        const formPanel= document.getElementById("demoPanelForm");
        if (!calBtn || !formBtn) return;

        if (tab === "calendar") {
          calBtn.classList.add("active");
          formBtn.classList.remove("active");
          calPanel.classList.add("active");
          formPanel.classList.remove("active");
        } else {
          formBtn.classList.add("active");
          calBtn.classList.remove("active");
          formPanel.classList.add("active");
          calPanel.classList.remove("active");
        }
      },

      async submitDemoRequest(e) {
        e.preventDefault();
        const btn = document.getElementById("demoSubmitBtn");
        const form = document.getElementById("demoRequestForm");
        const successPanel = document.getElementById("demoSuccessPanel");

        const name      = (document.getElementById("demoName")?.value || "").trim();
        const phone     = (document.getElementById("demoPhone")?.value || "").trim();
        const shop      = (document.getElementById("demoShop")?.value || "").trim();
        const city      = (document.getElementById("demoCity")?.value || "").trim();
        const biz_type  = (document.getElementById("demoBizType")?.value || "").trim();
        const customers = (document.getElementById("demoCustomers")?.value || "").trim();
        const goal      = (document.getElementById("demoGoal")?.value || "").trim();

        if (!name || !phone) {
          alert("Please fill in your name and WhatsApp number.");
          return;
        }

        // Show loading state
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending…';
        }

        try {
          const res = await fetch("/api/demo-request", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, phone, shop, city, biz_type, customers, goal })
          });
          const data = await res.json();

          if (res.ok && data.success) {
            // Hide form, show success
            if (form) form.style.display = "none";
            if (successPanel) successPanel.classList.add("show");
          } else {
            alert(data.error || "Something went wrong. Please try again.");
            if (btn) {
              btn.disabled = false;
              btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send My Demo Request';
            }
          }
        } catch (err) {
          alert("Network error. Please check your connection and try again.");
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Send My Demo Request';
          }
        }
      }
    };

    // ── DemoCalendar: Custom Appointment Booking Engine ──────────────────────
    const DemoCalendar = {
      _inited: false,
      curYear: 0,
      curMonth: 0,
      selectedDate: null,   // "YYYY-MM-DD"
      selectedSlot: null,   // "10:00 AM"
      bookedSlots: {},      // { "YYYY-MM-DD": ["10:00 AM", ...] }

      // Available time slots (Mon–Fri only, 10 AM – 5 PM)
      ALL_SLOTS: [
        "10:00 AM","10:30 AM","11:00 AM","11:30 AM",
        "12:00 PM","12:30 PM","01:00 PM","01:30 PM",
        "02:00 PM","02:30 PM","03:00 PM","03:30 PM",
        "04:00 PM","04:30 PM","05:00 PM"
      ],

      init() {
        if (this._inited) return;
        this._inited = true;
        const now = new Date();
        this.curYear  = now.getFullYear();
        this.curMonth = now.getMonth();
        this.renderMonth();
      },

      isWeekend(year, month, day) {
        const d = new Date(year, month, day).getDay();
        return d === 0 || d === 6;
      },

      isPast(year, month, day) {
        const today = new Date();
        today.setHours(0,0,0,0);
        return new Date(year, month, day) < today;
      },

      dateKey(year, month, day) {
        return `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
      },

      renderMonth() {
        const months = ["January","February","March","April","May","June",
                        "July","August","September","October","November","December"];
        document.getElementById("apptMonthLabel").textContent =
          `${months[this.curMonth]} ${this.curYear}`;

        // Disable prev button if current month is this month
        const now = new Date();
        const prevBtn = document.getElementById("apptPrevMonth");
        if (prevBtn) {
          prevBtn.disabled = (this.curYear === now.getFullYear() && this.curMonth <= now.getMonth());
        }

        const grid = document.getElementById("apptMiniGrid");
        // Keep the 7 DOW headers, remove old day cells
        const rows = grid.querySelectorAll(".appt-day-cell");
        rows.forEach(r => r.remove());

        const firstDay = new Date(this.curYear, this.curMonth, 1).getDay();
        const daysInMonth = new Date(this.curYear, this.curMonth + 1, 0).getDate();
        const today = new Date();
        today.setHours(0,0,0,0);

        // Empty cells before first day
        for (let i = 0; i < firstDay; i++) {
          const e = document.createElement("button");
          e.className = "appt-day-cell empty";
          grid.appendChild(e);
        }

        for (let d = 1; d <= daysInMonth; d++) {
          const btn = document.createElement("button");
          btn.className = "appt-day-cell";
          btn.textContent = d;
          const key = this.dateKey(this.curYear, this.curMonth, d);
          const isWknd = this.isWeekend(this.curYear, this.curMonth, d);
          const isPast = this.isPast(this.curYear, this.curMonth, d);

          if (isPast || isWknd) {
            btn.classList.add("disabled");
          } else {
            btn.classList.add("has-slots");
          }

          if (key === this.dateKey(today.getFullYear(), today.getMonth(), today.getDate())) {
            btn.classList.add("today");
          }
          if (key === this.selectedDate) btn.classList.add("selected");

          btn.onclick = () => this.selectDate(this.curYear, this.curMonth, d, btn);
          grid.appendChild(btn);
        }
      },

      prevMonth() {
        this.curMonth--;
        if (this.curMonth < 0) { this.curMonth = 11; this.curYear--; }
        this.renderMonth();
      },

      nextMonth() {
        this.curMonth++;
        if (this.curMonth > 11) { this.curMonth = 0; this.curYear++; }
        this.renderMonth();
      },

      selectDate(year, month, day, btn) {
        // Update selection highlight
        document.querySelectorAll(".appt-day-cell.selected").forEach(b => b.classList.remove("selected"));
        btn.classList.add("selected");
        this.selectedDate = this.dateKey(year, month, day);
        this.selectedSlot = null;
        this.showSlots();
        // Switch to slots view
        document.getElementById("apptSlotsView").style.display = "flex";
        document.getElementById("apptSlotsView").style.flexDirection = "column";
        document.getElementById("apptConfirmView").classList.remove("show");
      },

      showSlots() {
        const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
        const [y, m, d] = this.selectedDate.split("-").map(Number);
        const dateObj = new Date(y, m-1, d);
        const days = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
        document.getElementById("apptSelectedDateLabel").textContent =
          `${days[dateObj.getDay()]}, ${months[m-1]} ${d}`;

        // Detect user timezone
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "Asia/Kolkata";
        const offset = -new Date().getTimezoneOffset();
        const h = Math.floor(Math.abs(offset)/60), min = Math.abs(offset)%60;
        const tzStr = `GMT${offset>=0?'+':'-'}${String(h).padStart(2,'0')}:${String(min).padStart(2,'0')}`;
        document.getElementById("apptTzBadge").textContent = `${tz.split('/').pop().replace('_',' ')} (${tzStr})`;

        const booked = this.bookedSlots[this.selectedDate] || [];
        const grid = document.getElementById("apptSlotsGrid");
        grid.innerHTML = "";

        this.ALL_SLOTS.forEach(slot => {
          const isBooked = booked.includes(slot);
          const btn = document.createElement("button");
          btn.className = "appt-slot-btn" + (isBooked ? " booked" : "");
          btn.innerHTML = `<span>${slot}</span><span class="slot-dur">30 min</span>`;
          btn.disabled = isBooked;
          btn.onclick = () => this.selectSlot(slot, btn);
          grid.appendChild(btn);
        });
      },

      selectSlot(slot, btn) {
        document.querySelectorAll(".appt-slot-btn.selected").forEach(b => b.classList.remove("selected"));
        btn.classList.add("selected");
        this.selectedSlot = slot;

        // Show confirm view after short delay
        setTimeout(() => {
          const [y, m, d] = this.selectedDate.split("-").map(Number);
          const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
          const days = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
          const dateObj = new Date(y, m-1, d);
          const label = `${days[dateObj.getDay()]}, ${months[m-1]} ${d} ${y} · ${slot}`;
          document.getElementById("apptConfirmSlotLabel").textContent = label;
          document.getElementById("apptSlotsView").style.display = "none";
          document.getElementById("apptConfirmView").classList.add("show");
        }, 220);
      },

      backToSlots() {
        document.getElementById("apptConfirmView").classList.remove("show");
        document.getElementById("apptSlotsView").style.display = "flex";
        document.getElementById("apptSlotsView").style.flexDirection = "column";
      },

      async confirmBooking() {
        const name  = (document.getElementById("apptName")?.value || "").trim();
        const phone = (document.getElementById("apptPhone")?.value || "").trim();
        const email = (document.getElementById("apptEmail")?.value || "").trim();
        const shop  = (document.getElementById("apptShop")?.value || "").trim();

        if (!name || !phone) {
          alert("Please enter your name and WhatsApp number to confirm.");
          return;
        }

        const btn = document.getElementById("apptConfirmBtn");
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Confirming…';

        try {
          const res = await fetch("/api/demo-request", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name, phone, shop,
              city: "",
              biz_type: "Appointment",
              customers: "",
              goal: `Scheduled appointment: ${this.selectedDate} at ${this.selectedSlot}`,
              appointment_date: this.selectedDate,
              appointment_time: this.selectedSlot,
              email
            })
          });
          const data = await res.json();

          if (res.ok && data.success) {
            // Mark slot as booked locally
            if (!this.bookedSlots[this.selectedDate]) this.bookedSlots[this.selectedDate] = [];
            this.bookedSlots[this.selectedDate].push(this.selectedSlot);

            // Show success
            const [y, m, d] = this.selectedDate.split("-").map(Number);
            const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
            document.getElementById("apptBookedMsg").textContent =
              `Your 30-min demo is set for ${months[m-1]} ${d}, ${y} at ${this.selectedSlot} IST. We'll send a Google Meet link to your WhatsApp shortly.`;
            const wa = `https://wa.me/919994770276?text=Hi!%20I%20booked%20a%20demo%20for%20${encodeURIComponent(this.selectedDate)}%20at%20${encodeURIComponent(this.selectedSlot)}`;
            document.getElementById("apptWhatsappLink").href = wa;

            document.getElementById("apptCalMain").style.display = "none";
            document.getElementById("apptBookedPanel").classList.add("show");
          } else {
            alert(data.error || "Something went wrong. Please try again.");
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-calendar-check"></i> Confirm Appointment';
          }
        } catch (err) {
          alert("Network error. Please try again.");
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-calendar-check"></i> Confirm Appointment';
        }
      }
    };

    document.addEventListener("DOMContentLoaded", () => {
      LandingApp.init();
      // Close demo modal on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const backdrop = document.getElementById("demoModalBackdrop");
          if (backdrop && backdrop.classList.contains("open")) {
            backdrop.classList.remove("open");
            document.body.style.overflow = "";
          }
        }
      });
    });
  </script>
</body>
</html>
