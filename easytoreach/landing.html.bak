  <!-- ================= FAQ ================= -->
  <section class="full-width-section alt-bg" id="faq">
    <div class="section-container">
      <div class="section-header reveal">
        <span class="section-badge">Got Questions?</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-desc">Everything you need to know about setting up WhatsApp automation for your business.</p>
      </div>

      <div class="faq-list">
        <div class="faq-item reveal" onclick="LandingApp.toggleFAQ(this)">
          <div class="faq-q">
            <span>Can messages be sent with our store's verified name instead of a random number?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
          <div class="faq-a">Yes! EasyToReach connects directly to official Meta WhatsApp Cloud API. Once verified, your business's official name and verified checkmark appear at the top of customer chats.</div>
        </div>

        <div class="faq-item reveal" onclick="LandingApp.toggleFAQ(this)">
          <div class="faq-q">
            <span>How does the automated birthday discount work?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
          <div class="faq-a">Every day at 9:00 AM, our background engine scans your customer database. Anyone having a birthday today receives an exclusive personalized discount voucher (e.g. 15% OFF valid for 7 days). Our anti-spam ledger ensures no customer ever receives duplicate wishes in the same calendar year.</div>
        </div>

        <div class="faq-item reveal" onclick="LandingApp.toggleFAQ(this)">
          <div class="faq-q">
            <span>Can we import our existing customer Excel or Google Sheets list?</span>
            <i class="fa-solid fa-chevron-down"></i>
          </div>
